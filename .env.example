APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

API_TOKEN_EXPIRATION_DAYS=30
API_DOCS_ENABLED=false
API_CORS_ALLOWED_ORIGINS=
API_LOGIN_RATE_LIMIT=5
API_READ_RATE_LIMIT=120
API_WRITE_RATE_LIMIT=60

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# DB_SSLMODE=require
# For Supabase use DB_CONNECTION=pgsql and a DB_URL or pgsql host credentials.
# Use the direct connection string for migrations/imports and the session pooler for app runtime.
# DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.cvlkhmbveyvhidjzzmxi.supabase.co:5432/postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
ISSUE_ATTACHMENTS_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AI_DEFAULT_PROVIDER=openrouter
OPENROUTER_API_KEY=
AUTOMATION_AI_MODEL=
AUTOMATION_AI_HEALING_MODEL=
AUTOMATION_AI_TIMEOUT_SECONDS=180
AUTOMATION_AI_HEALING_TIMEOUT_SECONDS=180
